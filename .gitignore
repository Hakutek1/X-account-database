# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment values (keep only the blank example file)
.env*
.dev.vars*
!.dev.vars.example

# per-installation hosting metadata and database IDs
/.openai/
/wrangler.jsonc

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/tsconfig.tsbuildinfo
/outputs/
/work/
/generated_images/
